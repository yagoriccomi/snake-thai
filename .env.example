# ==============================================================================
# Snake Thai — Variáveis de Ambiente (Expo)
# ------------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha os valores. NUNCA comite o `.env`.
# Variáveis com prefixo EXPO_PUBLIC_ são embutidas no bundle do app em build.
# ==============================================================================

# URL do projeto Supabase. Ex.: https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Chave pública "anon" do Supabase.
# É segura para uso no cliente porque toda a proteção de dados vem das políticas
# de RLS no banco. A chave "service_role" NUNCA deve ser colocada no app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ==============================================================================
# Backend próprio (Render) — comprovantes de pagamento
# ------------------------------------------------------------------------------
# O app NÃO guarda nenhum segredo de terceiro. Tudo com prefixo EXPO_PUBLIC_ vai
# dentro do APK e pode ser extraído por qualquer pessoa que baixe o aplicativo.
#
# A api_key e a api_secret da Cloudinary vivem SÓ na Render, dentro do
# snake-server — é ele que assina o upload e a URL de visualização. O app recebe
# o cloud_name e o destino do arquivo NA RESPOSTA de /v1/proofs/sign-upload,
# derivados do token já verificado.
# ==============================================================================

# URL pública do backend na Render. OPCIONAL: com ela vazia, o app envia o
# comprovante pelo Supabase Storage, como sempre fez — nada quebra.
# Preencha após o primeiro deploy. Ver docs/BACKEND.md.
# Ex.: https://snakethai-api.onrender.com
EXPO_PUBLIC_API_URL=

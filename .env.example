# ==============================================================================
# Snake Thai — Variáveis de Ambiente (Expo)
# ------------------------------------------------------------------------------
# O app tem DUAS variantes, cada uma com o seu arquivo (nenhum vai para o Git):
#
#   .env.dev   "DEV Snake Thai" — banco LOCAL (Supabase CLI em Docker).
#              Gere com: scripts\db-dev env   (ou ./scripts/db-dev.sh env)
#   .env.prod  app de produção — copie este arquivo e preencha com os valores
#              do painel da Supabase de PRODUÇÃO.
#
# O `.env` simples NÃO é mais lido: os comandos passam por
# scripts/with-variant.js (npm start, npm run start:prod, menu.bat), que escolhe
# o arquivo e recusa combinações perigosas (app DEV apontando para produção, ou
# app de produção apontando para endereço local).
#
# Variáveis com prefixo EXPO_PUBLIC_ são embutidas no APK: nada aqui é segredo.
# ==============================================================================

# URL do projeto Supabase.
#   produção: https://xxxxxxxxxxxx.supabase.co
#   dev:      http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_URL=

# Chave pública "anon" do Supabase. É segura no cliente porque toda a proteção
# de dados vem da RLS no banco. A chave "service_role" NUNCA vai no app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# URL do backend próprio (snake-server). OPCIONAL: vazia, o comprovante vai pelo
# Supabase Storage e o anexo de justificativa fica indisponível.
#   produção: https://snakethai-api.onrender.com
#   dev:      http://127.0.0.1:3000 (snake-server local; ver docs/RUNBOOK.md)
EXPO_PUBLIC_API_URL=

# Monitoramento de erros (Sentry). OPCIONAL: vazio, o monitoramento fica
# desligado. É o DSN do projeto no painel do Sentry; vai embutido no APK, então
# não é segredo forte. O token de envio de source maps (SENTRY_AUTH_TOKEN) NUNCA
# entra aqui nem leva o prefixo EXPO_PUBLIC_: fica só na máquina de build.
EXPO_PUBLIC_SENTRY_DSN=

# Notificações push (docs/NOTIFICACOES.md). OPCIONAIS: vazias, o app compila e
# mostra "notificações indisponíveis".
# projectId do projeto na Expo (expo.dev). Não é segredo.
EAS_PROJECT_ID=
# Caminho do google-services.json do Firebase. Vazio = ./google-services.json
# na raiz, se existir. O arquivo NUNCA entra no Git (repositório público).
GOOGLE_SERVICES_JSON=

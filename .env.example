# ==============================================================================
# Snake Thai — Variáveis de Ambiente (Expo)
# ------------------------------------------------------------------------------
# Copie este arquivo para `.env` e preencha os valores. NUNCA comite o `.env`.
# Variáveis com prefixo EXPO_PUBLIC_ são embutidas no bundle do app em build.
# ==============================================================================

# URL do projeto Supabase. Ex.: https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Chave pública "anon" do Supabase.
# É segura para uso no cliente porque toda a proteção de dados vem das políticas
# de RLS no banco. A chave "service_role" NUNCA deve ser colocada no app.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ==============================================================================
# Cloudinary — comprovantes de pagamento
# ------------------------------------------------------------------------------
# CLIENTE (seguro embutir no app): apenas o cloud_name e, no fluxo de upload
# NÃO ASSINADO, o nome do preset. NUNCA coloque a api_secret aqui — tudo com
# EXPO_PUBLIC_ vai dentro do APK e pode ser extraído.
# ==============================================================================

# Nome da conta Cloudinary (público). Ex.: "snakethai"
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Preset de upload NÃO ASSINADO (só se o app subir direto para a Cloudinary).
# Crie no painel como "Unsigned", restrito à pasta de comprovantes, com formato
# e tamanho limitados. Deixe vazio se for usar upload ASSINADO via Edge Function
# (recomendado — comprovante é dado financeiro/PII).
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# URL pública do servidor de comprovantes (Render). Preencha após o deploy.
# Ex.: https://snakethai-comprovantes.onrender.com
EXPO_PUBLIC_PROOF_SERVER_URL=

# ------------------------------------------------------------------------------
# SERVIDOR — a api_key e a api_secret ficam nos SEGREDOS da Edge Function do
# Supabase, JAMAIS neste arquivo e JAMAIS com prefixo EXPO_PUBLIC_. A assinatura
# do upload e a URL de visualização autenticada exigem a api_secret, que só pode
# viver no servidor. Configure com:
#
#   supabase secrets set CLOUDINARY_API_KEY=<sua_api_key>
#   supabase secrets set CLOUDINARY_API_SECRET=<sua_api_secret>
# ------------------------------------------------------------------------------

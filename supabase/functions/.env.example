# Segredos das Edge Functions — só os NOMES. Os valores vão em
#   npx supabase secrets set NOME=valor --project-ref <ref>   (produção)
# ou num arquivo local fora do Git, passado com --env-file (ensaio local).

# send-push (notificações push; ver docs/NOTIFICACOES.md)
PUSH_DISPATCH_SECRET=
PUSH_APP_VARIANT=production
EXPO_ACCESS_TOKEN=
# Só para ensaio local com um servidor falso no lugar da Expo:
# EXPO_PUSH_API_URL=http://host.docker.internal:8765

{
  "expo": {
    "name": "Snake Thai",
    "slug": "snake-thai",
    "version": "1.7.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "snakethai",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0D0D",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.snakethai.app"
    },
    "android": {
      "package": "com.snakethai.app",
      "versionCode": 1007000,
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      [
        "./plugins/withReleaseSigning.js",
        {
          "exigirChaveDeProducao": true
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "organization": "num-tem",
          "project": "snake-thai"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita que o Snake Thai use o FaceID para proteger o acesso do administrador."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Snake Thai acessa suas fotos para você anexar o comprovante de pagamento."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#39FF14",
          "defaultChannel": "geral"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "2139fb00-b272-4518-b577-38e16f8a0b95"
      }
    }
  }
}

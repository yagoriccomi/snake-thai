# Valida a mensagem de commit no padrão Conventional Commits.
# Ex.: feat(auth): adiciona login  |  fix: corrige cálculo de mensalidade
commit_msg=$(head -n1 "$1")

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .{1,}'

if ! echo "$commit_msg" | grep -Eq "$pattern"; then
  echo "❌ Mensagem de commit fora do padrão Conventional Commits."
  echo "   Recebido: \"$commit_msg\""
  echo "   Formato:  <tipo>(escopo opcional): descrição"
  echo "   Tipos:    feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  exit 1
fi
